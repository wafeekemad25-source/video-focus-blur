{
  "manifest_version": 3,
  "name": "Video Focus Blur",
  "version": "1.0.0",
  "description": "Blurs everything on the page except the video you're watching.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_title": "Video Focus Blur"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-focus": {
      "suggested_key": { "default": "Alt+B", "mac": "Alt+B" },
      "description": "Turn the blur on/off"
    }
  },
  "background": { "service_worker": "background.js" },
  "browser_specific_settings": {
    "gecko": { "id": "video-focus-blur@local", "strict_min_version": "121.0" }
  }
}
